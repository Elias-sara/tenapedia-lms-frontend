    },
    "build": {
        "env": {
            "NEXT_PUBLIC_API_URL": "https://tenapedia-lms-backend-1.onrender.com",
            "NEXT_PUBLIC_UPLOAD_URL": "https://tenapedia-lms-backend-1.onrender.com/uploads",
            "NEXT_PUBLIC_STUDENT_API_URL": "https://tenapedia-lms-backend-1.onrender.com/api/students"
        }
    }
